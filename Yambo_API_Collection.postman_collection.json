{
  "info": {
    "name": "Yambo API Collection",
    "description": "Complete API collection for Yambo application with authentication, user management, admin operations, and invitation system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "invitation_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Check if the API is running"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('auth_token', response.token);",
                  "    console.log('Token saved:', response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticate user and get JWT token"
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"password\": \"password123\",\n  \"name\": \"New User\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register?invitation={{invitation_token}}",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"],
              "query": [
                {
                  "key": "invitation",
                  "value": "{{invitation_token}}"
                }
              ]
            },
            "description": "Register a new user with invitation token"
          }
        },
        {
          "name": "Reload Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/reload",
              "host": ["{{base_url}}"],
              "path": ["auth", "reload"]
            },
            "description": "Refresh JWT token"
          }
        }
      ]
    },
    {
      "name": "User Management",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/user/me",
              "host": ["{{base_url}}"],
              "path": ["user", "me"]
            },
            "description": "Get current authenticated user information"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\",\n  \"email\": \"updated@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/profile",
              "host": ["{{base_url}}"],
              "path": ["user", "profile"]
            },
            "description": "Update user profile (name and email)"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"oldpassword123\",\n  \"newPassword\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/change-password",
              "host": ["{{base_url}}"],
              "path": ["user", "change-password"]
            },
            "description": "Change user password"
          }
        },
        {
          "name": "Delete Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/user/delete",
              "host": ["{{base_url}}"],
              "path": ["user", "delete"]
            },
            "description": "Delete current user account"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/users?page=0&size=20&sortBy=name&direction=ASC&name=&email=&enabled=&permissions=&profiles=",
              "host": ["{{base_url}}"],
              "path": ["admin", "users"],
              "query": [
                {
                  "key": "page",
                  "value": "0",
                  "description": "Page number (0-based)"
                },
                {
                  "key": "size",
                  "value": "20",
                  "description": "Page size"
                },
                {
                  "key": "sortBy",
                  "value": "name",
                  "description": "Sort field (id, name, email, username, createdAt)"
                },
                {
                  "key": "direction",
                  "value": "ASC",
                  "description": "Sort direction (ASC or DESC)"
                },
                {
                  "key": "name",
                  "value": "",
                  "description": "Filter by name (partial match)"
                },
                {
                  "key": "email",
                  "value": "",
                  "description": "Filter by email (partial match)"
                },
                {
                  "key": "enabled",
                  "value": "",
                  "description": "Filter by enabled status (true/false)"
                },
                {
                  "key": "permissions",
                  "value": "",
                  "description": "Filter by permissions (comma-separated)"
                },
                {
                  "key": "profiles",
                  "value": "",
                  "description": "Filter by profiles (comma-separated)"
                }
              ]
            },
            "description": "List users with pagination, sorting and filtering (Admin only)"
          }
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 2,\n  \"name\": \"Updated User Name\",\n  \"email\": \"updated@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/users/profile",
              "host": ["{{base_url}}"],
              "path": ["admin", "users", "profile"]
            },
            "description": "Update user profile (name and email) by admin"
          }
        },
        {
          "name": "Update User Profiles",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profileIds\": [\"ROLE_USER\", \"ROLE_ADMIN\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/users/profiles?userId=2",
              "host": ["{{base_url}}"],
              "path": ["admin", "users", "profiles"],
              "query": [
                {
                  "key": "userId",
                  "value": "2",
                  "description": "User ID to update profiles for"
                }
              ]
            },
            "description": "Update user profiles/permissions by admin"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/users/2?confirm=true",
              "host": ["{{base_url}}"],
              "path": ["admin", "users", "2"],
              "query": [
                {
                  "key": "confirm",
                  "value": "true",
                  "description": "Confirmation flag (must be true)"
                }
              ]
            },
            "description": "Delete user by admin (requires confirmation)"
          }
        },
        {
          "name": "Create Invitation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('invitation_token', response.token);",
                  "    console.log('Invitation token saved:', response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"invitee@example.com\",\n  \"name\": \"Invitee User\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/invitations",
              "host": ["{{base_url}}"],
              "path": ["invitations"]
            },
            "description": "Create user invitation (Admin only)"
          }
        }
      ]
    }
  ]
}
