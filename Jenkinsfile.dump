// ============================================================================
// Jenkinsfile.dump — Anonymized DB Dump Job
// ============================================================================
// Manually-triggered pipeline that runs scripts/anonymize-dump.sh inside the
// production postgres pod, archives the result as a downloadable artifact, and
// emails a download link with local-restore instructions.
//
// Parameters:
//   MODE     — seed-data (data-only, for an already-migrated DB)
//              database-bootstrap (full schema+data for a clean restore)
//   FILENAME — output filename (must end in .sql)
// ============================================================================

pipeline {
    agent any

    environment {
        KUBECONFIG         = '/var/lib/jenkins/.kube/config'
        NAMESPACE          = 'yambo'
        NOTIFICATION_EMAIL = credentials('notification-email')
    }

    parameters {
        choice(
            name: 'MODE',
            choices: ['seed-data', 'database-bootstrap'],
            description: '''seed-data: data-only INSERT statements for an already-migrated database.
database-bootstrap: full schema + data dump; use createdb + psql to restore from scratch.'''
        )
        string(
            name: 'FILENAME',
            defaultValue: 'yambo-anon-dump.sql',
            description: 'Output filename. Must end with .sql'
        )
    }

    stages {

        // ─────────────────────────────────────────────────────────────────────
        // 1 — Validate inputs
        // ─────────────────────────────────────────────────────────────────────

        stage('Validate') {
            steps {
                script {
                    if (!params.FILENAME.endsWith('.sql')) {
                        error "FILENAME must end in .sql — got: '${params.FILENAME}'"
                    }
                    if (!params.FILENAME.matches('[\\w\\-\\.]+\\.sql')) {
                        error "FILENAME contains invalid characters: '${params.FILENAME}'"
                    }
                    echo "Mode: ${params.MODE}"
                    echo "Output file: ${params.FILENAME}"
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // 2 — Checkout (needed for scripts/anonymize-dump.sh)
        // ─────────────────────────────────────────────────────────────────────

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // 3 — Generate anonymized dump
        // ─────────────────────────────────────────────────────────────────────

        stage('Generate Anonymized Dump') {
            steps {
                script {
                    // Resolve the live postgres pod name
                    def podList = sh(
                        script: "kubectl get pod -n ${NAMESPACE} -l app=postgres --field-selector=status.phase=Running -o jsonpath='{.items[*].metadata.name}'",
                        returnStdout: true
                    ).trim()

                    def pods = podList ? podList.split(' ') : []
                    if (pods.size() == 0) {
                        error "No running postgres pod found in namespace ${NAMESPACE} (label app=postgres)"
                    }
                    if (pods.size() > 1) {
                        echo "Warning: ${pods.size()} postgres pods found -- using first: ${pods[0]}"
                    }
                    def podName = pods[0]
                    echo "Using pod: ${podName}"

                    timeout(time: 10, unit: 'MINUTES') {
                        try {
                            sh """
                                chmod +x scripts/anonymize-dump.sh
                                kubectl cp scripts/anonymize-dump.sh ${NAMESPACE}/${podName}:/tmp/anonymize-dump.sh
                            """

                            // Ensure bash is available (alpine-based images may need it)
                            sh "kubectl exec ${podName} -n ${NAMESPACE} -- sh -c 'command -v bash >/dev/null 2>&1 || apk add --no-cache bash >/dev/null 2>&1' || true"

                            // Write pgpass inside the pod -- credentials never appear in the Jenkins log
                            sh """
                                set +x
                                DB_USER=\$(kubectl get secret yambo-secrets -n ${NAMESPACE} -o jsonpath='{.data.DB_USER}' | base64 -d)
                                DB_PASS=\$(kubectl get secret yambo-secrets -n ${NAMESPACE} -o jsonpath='{.data.DB_PASS}' | base64 -d)

                                kubectl exec ${podName} -n ${NAMESPACE} -- sh -c "
                                    printf 'localhost:5432:yambo_db:%s:%s\\n' \"\${DB_USER}\" \"\${DB_PASS}\" > /tmp/.pgpass
                                    chmod 600 /tmp/.pgpass
                                "

                                kubectl exec ${podName} -n ${NAMESPACE} -- env \\
                                    PROD_DB_HOST=db.${NAMESPACE}.svc.cluster.local \\
                                    PROD_DB_PORT=5432 \\
                                    PGHOST=/var/run/postgresql \\
                                    PGPASSFILE=/tmp/.pgpass \\
                                    ANONYMIZE_DUMP_MODE=${params.MODE} \\
                                    bash /tmp/anonymize-dump.sh /tmp/${params.FILENAME}
                            """

                            sh "kubectl cp ${NAMESPACE}/${podName}:/tmp/${params.FILENAME} ${WORKSPACE}/${params.FILENAME}"
                        } finally {
                            sh "kubectl exec ${podName} -n ${NAMESPACE} -- rm -f /tmp/anonymize-dump.sh /tmp/${params.FILENAME} /tmp/.pgpass || true"
                        }
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // 4 — Archive artifact and print instructions
        // ─────────────────────────────────────────────────────────────────────

        stage('Archive & Publish') {
            steps {
                archiveArtifacts artifacts: params.FILENAME, fingerprint: true

                script {
                    def downloadUrl = "${env.BUILD_URL}artifact/${params.FILENAME}"

                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                    echo "✅ Artifact archived:"
                    echo "   ${downloadUrl}"
                    echo ""
                    echo "   Download with:"
                    echo "   curl -u <user>:<api-token> -L -o ${params.FILENAME} '${downloadUrl}'"
                    echo ""

                    if (params.MODE == 'database-bootstrap') {
                        echo "── Restore instructions (database-bootstrap) ──────"
                        echo "   # Creates a fresh local DB from scratch:"
                        echo "   createdb yambo_local"
                        echo "   psql -d yambo_local < ${params.FILENAME}"
                        echo ""
                        echo "   # Then point your app at it:"
                        echo "   export SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/yambo_local"
                    } else {
                        echo "── Restore instructions (seed-data) ───────────────"
                        echo "   # Requires an already-migrated DB. Run migrations first:"
                        echo "   cd backend && ./mvnw spring-boot:run  # starts app → runs Liquibase"
                        echo ""
                        echo "   # Then load the seed data (truncate existing rows first):"
                        echo "   psql -d yambo_local < ${params.FILENAME}"
                    }

                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

                    // Store for post block
                    env.DOWNLOAD_URL  = downloadUrl
                    env.DUMP_MODE     = params.MODE
                    env.DUMP_FILENAME = params.FILENAME
                }
            }
        }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Post
    // ─────────────────────────────────────────────────────────────────────────

    post {
        success {
            script {
                def restoreInstructions = (env.DUMP_MODE == 'database-bootstrap')
                    ? """Restore (database-bootstrap -- full schema + data):\n  createdb yambo_local\n  psql -d yambo_local &lt; ${env.DUMP_FILENAME}"""
                    : """Restore (seed-data -- data only, migrations must already be applied):\n  psql -d yambo_local &lt; ${env.DUMP_FILENAME}"""

                try {
                    emailext(
                        to: env.NOTIFICATION_EMAIL,
                        mimeType: 'text/html',
                        subject: "[yambo] Anonymized dump ready -- ${env.DUMP_MODE}",
                        body: """<div style='font-family:Arial,sans-serif;max-width:600px'>
  <div style='background:#2ea44f;color:#fff;padding:16px 20px;border-radius:6px 6px 0 0'>
    <h2 style='margin:0'>Anonymized dump ready</h2>
  </div>
  <div style='border:1px solid #e1e4e8;border-top:none;padding:20px;border-radius:0 0 6px 6px'>
    <table style='border-collapse:collapse;width:100%;font-size:14px'>
      <tr><td style='padding:4px 8px;color:#586069'>Mode</td><td style='padding:4px 8px'>${env.DUMP_MODE}</td></tr>
      <tr><td style='padding:4px 8px;color:#586069'>File</td><td style='padding:4px 8px'><a href='${env.DOWNLOAD_URL}'>${env.DUMP_FILENAME}</a></td></tr>
    </table>
    <p style='margin-top:16px;font-size:13px;color:#586069'>Download:<br><code>curl -u &lt;user&gt;:&lt;api-token&gt; -L -o ${env.DUMP_FILENAME} '${env.DOWNLOAD_URL}'</code></p>
    <p style='font-size:13px;color:#586069'>${restoreInstructions}</p>
    <p style='font-size:12px;color:#6a737d'>Note: preview passwords for all users are set to <code>preview123</code>.</p>
    <table style='border-collapse:collapse;width:100%;font-size:14px'>
      <tr><td style='padding:4px 8px;color:#586069'>Job</td><td style='padding:4px 8px'><a href='${env.BUILD_URL}'>${env.JOB_NAME} #${env.BUILD_NUMBER}</a></td></tr>
    </table>
  </div>
</div>"""
                    )
                } catch (e) {
                    echo "Warning: email notification failed: ${e.message}"
                }
            }
        }

        failure {
            script {
                try {
                    emailext(
                        to: env.NOTIFICATION_EMAIL,
                        mimeType: 'text/html',
                        subject: "[yambo] Dump job failed -- #${env.BUILD_NUMBER}",
                        body: """<div style='font-family:Arial,sans-serif;max-width:600px'>
  <div style='background:#d73a49;color:#fff;padding:16px 20px;border-radius:6px 6px 0 0'>
    <h2 style='margin:0'>Dump job failed</h2>
  </div>
  <div style='border:1px solid #e1e4e8;border-top:none;padding:20px;border-radius:0 0 6px 6px'>
    <table style='border-collapse:collapse;width:100%;font-size:14px'>
      <tr><td style='padding:4px 8px;color:#586069'>Mode</td><td style='padding:4px 8px'>${params.MODE}</td></tr>
      <tr><td style='padding:4px 8px;color:#586069'>File</td><td style='padding:4px 8px'>${params.FILENAME}</td></tr>
      <tr><td style='padding:4px 8px;color:#586069'>Job</td><td style='padding:4px 8px'><a href='${env.BUILD_URL}'>${env.JOB_NAME} #${env.BUILD_NUMBER}</a></td></tr>
      <tr><td style='padding:4px 8px;color:#586069'>Console</td><td style='padding:4px 8px'><a href='${env.BUILD_URL}console'>View output</a></td></tr>
    </table>
  </div>
</div>"""
                    )
                } catch (e) {
                    echo "Warning: email notification failed: ${e.message}"
                }
            }
        }

        cleanup {
            // Remove the SQL file from the workspace after archiving to avoid
            // accumulation across builds
            sh "rm -f '${WORKSPACE}/${params.FILENAME}'"
        }
    }
}
