# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in your values
# Used by docker-compose.yml (local dev / integration)
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=yambo_user
DB_PASS=yambo_password

# ── Mail (optional — leave blank to disable email sending) ───────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@yambo-alco.es
MAIL_FROM_NAME=Yambo

# ── Frontend public URL (used by backend for CORS + redirect links) ───────────
# For local development:  http://localhost
# For production:         https://yambo.cabrasky.net
FRONTEND_URL=http://localhost

# ── Backend internal URL (used by the frontend SSR container to proxy API) ────
# Must match the docker-compose service name when running locally
BACKEND_INTERNAL_URL=http://backend:8080/api
