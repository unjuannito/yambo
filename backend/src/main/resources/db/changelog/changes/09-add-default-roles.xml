<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="09-add-default-roles" author="yambo">
        <!-- Add is_default column to roles table -->
        <addColumn tableName="roles">
            <column name="is_default" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <!-- Set INTERESADO as the default role -->
        <update tableName="roles">
            <column name="is_default" valueBoolean="true"/>
            <where>id = 'INTERESADO'</where>
        </update>

        <!-- Create index for faster queries -->
        <createIndex tableName="roles" indexName="idx_roles_is_default">
            <column name="is_default"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
