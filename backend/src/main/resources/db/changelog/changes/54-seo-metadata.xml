<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="54-1" author="yambo">
        <createTable tableName="seo_metadata" schemaName="public">
            <column name="id" type="VARCHAR(8)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="entity_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="VARCHAR(8)">
                <constraints nullable="false"/>
            </column>
            <column name="meta_description" type="VARCHAR(200)"/>
            <column name="keywords" type="jsonb" defaultValue="[]">
                <constraints nullable="false"/>
            </column>
            <column name="og_description" type="VARCHAR(300)"/>
            <column name="slug" type="VARCHAR(200)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
            tableName="seo_metadata"
            columnNames="entity_type, entity_id"
            constraintName="uq_seo_metadata_entity"/>
    </changeSet>

</databaseChangeLog>
