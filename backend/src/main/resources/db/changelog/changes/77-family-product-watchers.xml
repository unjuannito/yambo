<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="77-create-family-product-watcher-table" author="yambo">
        <comment>Create family_product_watcher table for Jira-style watchers on merch drops (all issues from a drop)</comment>

        <createTable tableName="family_product_watcher">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="family_product_id" type="char(8)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="family_product_watcher"
            baseColumnNames="family_product_id"
            referencedTableName="family_product"
            referencedColumnNames="id"
            constraintName="fk_family_product_watcher_family_product"
            onDelete="CASCADE"/>

        <addForeignKeyConstraint
            baseTableName="family_product_watcher"
            baseColumnNames="user_id"
            referencedTableName="user"
            referencedColumnNames="id"
            constraintName="fk_family_product_watcher_user"
            onDelete="SET NULL"/>

        <addUniqueConstraint
            tableName="family_product_watcher"
            columnNames="family_product_id, email"
            constraintName="uq_family_product_watcher_drop_email"/>
    </changeSet>

</databaseChangeLog>
