<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="26-order-customer-id-to-string" author="yambo">
        <comment>Change order.customer_id from integer to varchar to support user ID strings</comment>
        
        <!-- Drop payment_id column as it's not being used -->
        <dropColumn tableName="order" columnName="payment_id"/>
        
        <!-- Modify customer_id column type -->
        <modifyDataType tableName="order" columnName="customer_id" newDataType="varchar(255)"/>
        
    </changeSet>

</databaseChangeLog>
