<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="76-create-issue-watcher-table" author="yambo">
        <comment>Create issue_watcher table for Jira-style watchers/subscribers on individual issues</comment>

        <createTable tableName="issue_watcher">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="issue_id" type="char(8)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="issue_watcher"
            baseColumnNames="issue_id"
            referencedTableName="issue"
            referencedColumnNames="id"
            constraintName="fk_issue_watcher_issue"
            onDelete="CASCADE"/>

        <addForeignKeyConstraint
            baseTableName="issue_watcher"
            baseColumnNames="user_id"
            referencedTableName="user"
            referencedColumnNames="id"
            constraintName="fk_issue_watcher_user"
            onDelete="SET NULL"/>

        <addUniqueConstraint
            tableName="issue_watcher"
            columnNames="issue_id, email"
            constraintName="uq_issue_watcher_issue_email"/>
    </changeSet>

</databaseChangeLog>
