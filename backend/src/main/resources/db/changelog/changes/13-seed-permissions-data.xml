        <!-- FAMILY_PRODUCT permissions -->
        <insert tableName="profile_permission">
            <column name="profile_id" value="ADMIN"/>
            <column name="permission_id" value="PFAM_CRT"/>
        </insert>
        <insert tableName="profile_permission">
            <column name="profile_id" value="ADMIN"/>
            <column name="permission_id" value="PFAM_RD"/>
        </insert>
        <insert tableName="profile_permission">
            <column name="profile_id" value="ADMIN"/>
            <column name="permission_id" value="PFAM_UPD"/>
        </insert>
        <insert tableName="profile_permission">
            <column name="profile_id" value="ADMIN"/>
            <column name="permission_id" value="PFAM_DEL"/>
        </insert>
    </changeSet>

    <!-- Create default USER profile with read-only permissions -->
    <changeSet id="13-04-seed-user-profile" author="yambo">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM profile WHERE id = 'USER'</sqlCheck>
        </preConditions>

        <insert tableName="profile">
            <column name="id" value="USER"/>
            <column name="name" value="Standard User"/>
        </insert>
    </changeSet>

    <!-- Assign read permissions to USER profile -->
    <changeSet id="13-05-assign-user-permissions" author="yambo">
        <preConditions onFail="MARK_RAN">
            <and>
                <sqlCheck expectedResult="1">SELECT COUNT(*) FROM profile WHERE id = 'USER'</sqlCheck>
                <sqlCheck expectedResult="0">SELECT COUNT(*) FROM profile_permission WHERE profile_id = 'USER'</sqlCheck>
            </and>
        </preConditions>

        <!-- USER can read products, projects, and family products -->
        <insert tableName="profile_permission">
            <column name="profile_id" value="USER"/>
            <column name="permission_id" value="PPRD_RD"/>
        </insert>
        <insert tableName="profile_permission">
            <column name="profile_id" value="USER"/>
            <column name="permission_id" value="PPRJ_RD"/>
        </insert>
        <insert tableName="profile_permission">
            <column name="profile_id" value="USER"/>
            <column name="permission_id" value="PFAM_RD"/>
        </insert>
    </changeSet>

</databaseChangeLog>
