<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">


    <!-- Add app domain setting -->
    <changeSet id="32-01-add-app-domain" author="yambo">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM settings WHERE key = 'app.domain'
            </sqlCheck>
        </preConditions>

        <insert tableName="settings">
            <column name="id" value="SETT0017"/>
            <column name="key" value="app.domain"/>
            <column name="value" value="http://localhost"/>
            <column name="description" value="Dominio de la aplicación para enlaces en correos"/>
            <column name="category" value="app"/>
        </insert>
    </changeSet>

</databaseChangeLog>
