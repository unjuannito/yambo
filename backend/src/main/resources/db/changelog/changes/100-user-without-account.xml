<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Staff can be added before they have an account: such a user cannot log in
        (has_account = false) and may not have an email yet.
    -->
    <changeSet id="100-01-user-without-account" author="yambo">
        <addColumn tableName="user">
            <column name="has_account" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <dropNotNullConstraint tableName="user" columnName="email" columnDataType="VARCHAR(255)"/>
    </changeSet>

</databaseChangeLog>
