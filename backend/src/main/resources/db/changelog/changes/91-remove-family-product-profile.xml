<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="91" author="cabrasky">
        <comment>Remove deprecated auto-created profile association from family_product (access is now project+role based)</comment>

        <dropForeignKeyConstraint baseTableName="family_product" constraintName="fk_family_product_profile"/>
        <dropUniqueConstraint tableName="family_product" constraintName="uk_family_product_profile"/>
        <dropColumn tableName="family_product" columnName="profile_id"/>
    </changeSet>
</databaseChangeLog>
