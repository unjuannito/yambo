<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="60-add-system-flag-to-profile" author="system">
        <addColumn tableName="profile">
            <column name="system" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <update tableName="profile">
            <column name="system" valueBoolean="true"/>
            <where>id IN ('ADMIN', 'USER', 'PRJ_MGR1', 'MERCH_MG', 'P0000004', 'P0000005')</where>
        </update>
    </changeSet>

    <changeSet id="60-add-system-flag-to-user" author="system">
        <addColumn tableName="user">
            <column name="system" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <update tableName="user">
            <column name="system" valueBoolean="true"/>
            <where>id = 'UADMIN01'</where>
        </update>
    </changeSet>

</databaseChangeLog>
