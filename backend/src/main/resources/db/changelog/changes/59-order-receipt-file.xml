<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Add receipt_file_id column to order table for payment proof uploads -->
    <changeSet id="59-1" author="yambo">
        <addColumn tableName="order" schemaName="public">
            <column name="receipt_file_id" type="varchar(8)">
                <constraints nullable="true"
                             foreignKeyName="fk_order_receipt_file"
                             references="public.uploaded_file(id)"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
