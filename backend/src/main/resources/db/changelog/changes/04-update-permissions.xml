<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="04-update-permissions" author="yambo">
        <insert tableName="permissions">
            <column name="id" value="READ_PRIVILEGES"/>
            <column name="description" value="Read user data"/>
        </insert>
        <insert tableName="permissions">
            <column name="id" value="WRITE_PRIVILEGES"/>
            <column name="description" value="Modify user data"/>
        </insert>

        <update tableName="role_permissions">
            <column name="permission_id" value="READ_PRIVILEGES"/>
            <where>permission_id = 'PERM_READ_USERS'</where>
        </update>
        <update tableName="role_permissions">
            <column name="permission_id" value="WRITE_PRIVILEGES"/>
            <where>permission_id = 'PERM_WRITE_USERS'</where>
        </update>

        <delete tableName="permissions">
            <where>id = 'PERM_READ_USERS'</where>
        </delete>
        <delete tableName="permissions">
            <where>id = 'PERM_WRITE_USERS'</where>
        </delete>
    </changeSet>

</databaseChangeLog>
