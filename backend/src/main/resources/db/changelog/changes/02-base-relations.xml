<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="04-create-user-profile" author="yambo">
        <createTable tableName="user_profile">
            <column name="user_id" type="char(8)">
                <constraints nullable="false"/>
            </column>
            <column name="profile_id" type="char(8)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="05-create-user-project" author="yambo">
        <createTable tableName="user_project">
            <column name="user_id" type="char(8)">
                <constraints nullable="false"/>
            </column>
            <column name="project_id" type="char(8)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
