<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="05-create-pending-deletion-table" author="yambo">
        <createTable tableName="pending_deletion">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="object_type" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="object_id" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="requested_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="scheduled_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="deletion_status" type="varchar(50)"/>
        </createTable>

        <createIndex tableName="pending_deletion" indexName="idx_pending_deletion_scheduled_at">
            <column name="scheduled_at"/>
        </createIndex>

        <createIndex tableName="pending_deletion" indexName="idx_pending_deletion_object_type_id">
            <column name="object_type"/>
            <column name="object_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>