<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="01-create-user-table" author="yambo">
        <createTable tableName="user">
            <column name="id" type="char(8)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="password" type="varchar(60)" />
            <column name="email" type="varchar(255)" />
            <column name="name" type="varchar(255)" />
            <column name="created_at" type="timestamp" />
            <column name="created_by" type="char(8)" />
        </createTable>
    </changeSet>

    <changeSet id="02-create-profile-table" author="yambo">
        <createTable tableName="profile">
            <column name="id" type="char(8)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(64)" />
        </createTable>
    </changeSet>

    <changeSet id="03-create-project" author="yambo">
        <createTable tableName="project">
            <column name="id" type="char(8)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(64)" />
            <column name="active" type="tinyint(1)" />
        </createTable>
    </changeSet>

</databaseChangeLog>
