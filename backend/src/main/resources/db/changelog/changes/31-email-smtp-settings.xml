<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">


    <!-- Add email SMTP settings -->
    <changeSet id="31-01-add-email-smtp-auth" author="yambo">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM settings WHERE key = 'email.smtp.auth'
            </sqlCheck>
        </preConditions>

        <insert tableName="settings">
            <column name="id" value="SETT0011"/>
            <column name="key" value="email.smtp.auth"/>
            <column name="value" value="true"/>
            <column name="description" value="Habilitar autenticación SMTP"/>
            <column name="category" value="email"/>
        </insert>
    </changeSet>

