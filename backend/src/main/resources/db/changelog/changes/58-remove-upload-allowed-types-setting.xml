<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="58-remove-upload-allowed-types-setting" author="yambo">
        <comment>Remove upload.allowed_types setting since all file types are now accepted</comment>

        <delete tableName="settings">
            <where>key = 'upload.allowed_types'</where>
        </delete>

        <update tableName="settings">
            <column name="description" value="Tamaño máximo de archivo en MB"/>
            <where>key = 'upload.max_file_size_mb'</where>
        </update>
    </changeSet>
</databaseChangeLog>
